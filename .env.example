# Environment configuration
# Copy this file to .env and fill in real values

# Backend API
DATABASE_URL=sqlite:///./ndvi_drone.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/ndvi_drone
NDVI_API_KEY=dev-key-change-me

# MAVLink connection
MAVLINK_CONNECTION=/dev/ttyAMA0
MAVLINK_BAUD=921600

# Sync worker
BACKEND_URL=http://localhost:8000/api/readings
SYNC_INTERVAL=10

# Camera
RGB_CAMERA_ID=0
NIR_CAMERA_ID=1
CAPTURE_RESOLUTION=640x480
USE_HW_TRIGGER=false
TRIGGER_GPIO_PIN=17
